# Required only for live OpenRouter runs. Never commit the real value.
OPENROUTER_API_KEY=

# The official OpenRouter origin is fixed by default. A custom origin requires
# MING_ALLOW_CUSTOM_BASE_URL=true so credentials cannot be redirected by accident.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MING_ALLOW_CUSTOM_BASE_URL=false

# Named free models are preferences; the roster can rotate. Every route ends at
# openrouter/free, which selects a currently available zero-cost model.
MING_ORCHESTRATOR_MODELS=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free,openrouter/free
MING_CODER_MODELS=poolside/laguna-s-2.1:free,cohere/north-mini-code:free,openrouter/free
MING_FAST_MODELS=minimax/minimax-m3:free,google/gemma-4-26b-a4b-it:free,liquid/lfm-2.5-2.6b:free,openrouter/free

# OpenRouter currently lists no :free image-output model. This cheap 1K route is
# approximately $0.015/image and still requires explicit per-invocation approval.
MING_IMAGE_MODELS=krea/krea-2-medium-turbo
MING_IMAGE_ESTIMATED_COST_USD=0.015
# Required when more than one paid image model is listed. Format: model:price,...
# MING_IMAGE_MODEL_COSTS=krea/krea-2-medium-turbo:0.015

# Every runtime artifact is grouped below this workspace-confined root:
# logs/telemetry.db, iterations/*.json, and images/*.
MING_OUTPUT_DIR=./outputs

MING_REQUESTS_PER_MINUTE=20
MING_MAX_RETRIES=2
MING_MAX_SPECIALISTS=3
MING_HUMAN_RATE=75

# Capability index (codex.db). Must remain inside the current workspace.
MING_DATA_DIR=./data
